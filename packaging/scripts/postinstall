#!/bin/bash
# Runs as root after Glow is installed into /Library/Audio/Plug-Ins.
# Remove any older per-user copies (e.g. from the zip or build_mac.sh) so the DAW
# doesn't see two different versions of Glow, then make macOS rescan Audio Units.
CONSOLE_USER=$(stat -f%Su /dev/console 2>/dev/null)
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    USER_HOME=$(dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
    if [ -n "$USER_HOME" ]; then
        rm -rf "$USER_HOME/Library/Audio/Plug-Ins/Components/Glow.component"
        rm -rf "$USER_HOME/Library/Audio/Plug-Ins/VST3/Glow.vst3"
    fi
fi
# Glow used to ship as "Haren Audio" (same files, now Norka DSP): drop the old installer receipts
pkgutil --forget com.harenaudio.glow.au >/dev/null 2>&1 || true
pkgutil --forget com.harenaudio.glow.vst3 >/dev/null 2>&1 || true
killall -9 AudioComponentRegistrar 2>/dev/null || true
exit 0
